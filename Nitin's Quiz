export type GKCategory =
  | 'Indian History' | 'Indian Geography' | 'Indian Polity' | 'Indian Constitution'
  | 'General Science' | 'Physics' | 'Chemistry' | 'Biology'
  | 'Computer Knowledge' | 'Sports GK' | 'Awards and Honours' | 'Important Days'
  | 'Books and Authors' | 'Indian Economy' | 'Current Affairs' | 'Uttar Pradesh GK'
  | 'World GK' | 'Static GK';

export type QuestionYear = '2020' | '2021' | '2022' | '2023' | '2024' | '2025' | '2026';
export type QuestionType = 'pyq' | 'practice';

export interface Question {
  id: string;
  category: GKCategory;
  year: QuestionYear;
  type: QuestionType; // 'pyq' = Verified Previous Year Question, 'practice' = High Probability Practice
  examSource?: string;
  questionEn: string;
  questionHi: string;
  optionsEn: [string, string, string, string];
  optionsHi: [string, string, string, string];
  correctAnswerIndex: number;
  explanationEn: string;
  explanationHi: string;
}

export interface QuizAttempt {
  id: string;
  title: string;
  category?: string;
  year?: string;
  date: string;
  totalQuestions: number;
  attempted: number;
  correctAnswers: number;
  incorrectAnswers: number;
  unanswered: number;
  scorePercentage: number;
  timeSpentSeconds: number;
  userAnswers: Record<string, number>;
}import React, { useState, useEffect } from 'react';
